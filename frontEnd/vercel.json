{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend-app/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/auth",
      "destination": "https://auth-service-264198079598.us-central1.run.app/auth"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://auth-service-264198079598.us-central1.run.app/auth/:path*"
    },
    {
      "source": "/api/ordenes",
      "destination": "https://orders-service-264198079598.us-central1.run.app/ordenes"
    },
    {
      "source": "/api/ordenes/:path*",
      "destination": "https://orders-service-264198079598.us-central1.run.app/ordenes/:path*"
    },
    {
      "source": "/api/productos",
      "destination": "https://orders-service-264198079598.us-central1.run.app/productos"
    },
    {
      "source": "/api/productos/:path*",
      "destination": "https://orders-service-264198079598.us-central1.run.app/productos/:path*"
    },
    {
      "source": "/api/mesas",
      "destination": "https://orders-service-264198079598.us-central1.run.app/mesas"
    },
    {
      "source": "/api/mesas/:path*",
      "destination": "https://orders-service-264198079598.us-central1.run.app/mesas/:path*"
    },
    {
      "source": "/api/pagos",
      "destination": "https://payments-service-264198079598.us-central1.run.app/pagos"
    },
    {
      "source": "/api/pagos/:path*",
      "destination": "https://payments-service-264198079598.us-central1.run.app/pagos/:path*"
    },
    {
      "source": "/auth",
      "destination": "https://auth-service-264198079598.us-central1.run.app/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://auth-service-264198079598.us-central1.run.app/auth/:path*"
    },
    {
      "source": "/ordenes",
      "destination": "https://orders-service-264198079598.us-central1.run.app/ordenes"
    },
    {
      "source": "/ordenes/:path*",
      "destination": "https://orders-service-264198079598.us-central1.run.app/ordenes/:path*"
    },
    {
      "source": "/productos",
      "destination": "https://orders-service-264198079598.us-central1.run.app/productos"
    },
    {
      "source": "/productos/:path*",
      "destination": "https://orders-service-264198079598.us-central1.run.app/productos/:path*"
    },
    {
      "source": "/mesas",
      "destination": "https://orders-service-264198079598.us-central1.run.app/mesas"
    },
    {
      "source": "/mesas/:path*",
      "destination": "https://orders-service-264198079598.us-central1.run.app/mesas/:path*"
    },
    {
      "source": "/pagos",
      "destination": "https://payments-service-264198079598.us-central1.run.app/pagos"
    },
    {
      "source": "/pagos/:path*",
      "destination": "https://payments-service-264198079598.us-central1.run.app/pagos/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
