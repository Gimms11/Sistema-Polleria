# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA VERCEL (FRONTEND)
# ==============================================================================
# Configura estas variables en tu panel de Vercel:
# Project Settings -> Environment Variables
# ==============================================================================

# URLs de los Microservicios desplegados en Google Cloud Run
NG_APP_AUTH_API_URL=https://auth-service-xxxx-uc.a.run.app
NG_APP_ORDERS_API_URL=https://orders-service-xxxx-uc.a.run.app
NG_APP_PAYMENTS_API_URL=https://payments-service-xxxx-uc.a.run.app

# Clave pública de Mercado Pago (Sandbox o Producción)
NG_APP_MERCADOPAGO_PUBLIC_KEY=APP_USR-TU_CLAVE_PUBLICA_MERCADOPAGO
