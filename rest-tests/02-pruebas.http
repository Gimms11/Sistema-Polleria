###############################################################################
# SISTEMA POLLERÍA - FASE 1 (TESTS MULTI-NIVEL)
# Extensión: REST Client (humao.rest-client)
###############################################################################

# Entorno: Localhost (descomentar para pruebas locales)
# @AUTH_URL = http://localhost:8081
# @ORDERS_URL = http://localhost:8082
# @PAYMENTS_URL = http://localhost:8083
# @NOTIF_URL = http://localhost:3001

# Entorno: AWS EC2 / Cloudflare (activo)
@AUTH_URL = http://98.86.149.179:8081
@ORDERS_URL = http://100.53.223.167:8082
@PAYMENTS_URL = http://44.203.62.89:8083
@NOTIF_URL = https://high-ones-kerry-mobiles.trycloudflare.com

# Tokens extraídos dinámicamente de las respuestas de login
@TOKEN_ADMIN = {{loginAdmin.response.body.token}}
@TOKEN_CLIENTE = {{loginCliente.response.body.token}}
@TOKEN_MOZO = {{loginMozo.response.body.token}}
@TOKEN_COCINA = {{loginCocina.response.body.token}}
@TOKEN_REPARTIDOR = {{loginRepartidor.response.body.token}}

# IDs extraídos dinámicamente de las creaciones
@PRODUCTO_ID = {{createProduct.response.body.id}}
@MESA_ID = {{createMesa.response.body.id}}
@ORDEN_ID = {{createOrder.response.body.id}}
@PAGO_ID = {{createPayment.response.body.id}}


# ==============================================================================
# LEVEL 2: HAPPY PATH & FLUJO E2E
# ==============================================================================


# --- 2.1 Autenticacion Multi-Rol (5 Roles) ---

### 2.1.1 Registrar Usuario ADMIN
# Esperado: HTTP 201
POST {{AUTH_URL}}/auth/register
Content-Type: application/json

{
  "name": "Admin Pruebas",
  "email": "adminPruebas@sanpollo.com",
  "phone": "940521731",
  "password": "admin123",
  "role": "ADMIN"
}

### 2.1.2 Login ADMIN (Guarda TOKEN_ADMIN y TOKEN)
# Esperado: HTTP 200
# @name loginAdmin
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{
  "identifier": "adminPruebas@sanpollo.com",
  "password": "admin123"
}

### 2.1.2b Renovar Token con Refresh Token (RTR)
# Esperado: HTTP 200
# @name refreshTokenAdmin
POST {{AUTH_URL}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginAdmin.response.body.refreshToken}}"
}

### 2.1.2c Logout y Revocación de Sesión
# Esperado: HTTP 200
POST {{AUTH_URL}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshTokenAdmin.response.body.refreshToken}}"
}

### 112.1.3 Registrar Usuario CLIENTE
