  "name": "Juan Cliente",
  "email": "cliente@sanpollo.com",
  "phone": "912345678",
  "password": "cliente123",
  "role": "CLIENTE"
}

### 2.1.4 Login CLIENTE (Guarda TOKEN_CLIENTE y TOKEN)
# Esperado: HTTP 200
# @name loginCliente
