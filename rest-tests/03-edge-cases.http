# ==============================================================================
# LEVEL 3: SEGURIDAD & RBAC (401 / 403)
# ==============================================================================

### 3.1 Crear Producto sin Token (401)
# Esperado: HTTP 401
POST {{ORDERS_URL}}/productos
Content-Type: application/json

{
  "nombre": "Producto Invalido",
  "precio": 10.0,
  "categoria": "BEBIDA"
}

### 3.2 Crear Producto con Token CLIENTE (403)
# Esperado: HTTP 403
POST {{ORDERS_URL}}/productos
Content-Type: application/json
Authorization: Bearer {{TOKEN_CLIENTE}}

{
  "nombre": "Producto Hack",
  "precio": 1.0,
  "categoria": "BEBIDA",
  "disponible": true
}

### 3.3 Crear Mesa con Token CLIENTE (403)
# Esperado: HTTP 403
POST {{ORDERS_URL}}/mesas
Content-Type: application/json
Authorization: Bearer {{TOKEN_CLIENTE}}

{
  "numero": 99,
  "capacidad": 4
}

### 3.4 Ver Pantalla Cocina con Token CLIENTE (403)
# Esperado: HTTP 403
GET {{ORDERS_URL}}/ordenes/cocina
Authorization: Bearer {{TOKEN_CLIENTE}}

### 3.5 Crear Mesas con Token COCINA (403)
# Esperado: HTTP 403
POST {{ORDERS_URL}}/mesas
Content-Type: application/json
Authorization: Bearer {{TOKEN_COCINA}}

{
  "numero": 88,
  "capacidad": 4
}

### 3.6 Ver Todos los Pagos con Token REPARTIDOR (403)
# Esperado: HTTP 403
GET {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_REPARTIDOR}}

### 3.7 Token JWT Invalido o Manipulado (401)
# Esperado: HTTP 401
GET {{AUTH_URL}}/auth/validate
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.invalid.payload


# ==============================================================================
# LEVEL 4: VALIDACIONES Y CASOS BORDE (400 / 404)
# ==============================================================================

### 4.1 Login con Password Incorrecto (400/401)
# Esperado: HTTP 401
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{
  "identifier": "admin@sanpollo.com",
  "password": "wrongPassword123"
}

### 4.2 Consultar Producto Inexistente (404)
# Esperado: HTTP 404
GET {{ORDERS_URL}}/productos/999999

### 4.3 Crear Orden con Lista de Items Vacia (400)
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json
Authorization: Bearer {{TOKEN_CLIENTE}}

{
  "tipo": "SALON",
  "mesaId": "1",
  "items": []
}

### 4.4 Cambiar a Estado Invalido (400)
# Esperado: HTTP 400
PATCH {{ORDERS_URL}}/ordenes/11/estado
Content-Type: application/json
Authorization: Bearer {{TOKEN_ADMIN}}

{
  "estado": "ESTADO_INEXISTENTE"
}

### 4.5 Refresh Token Invalido o Expirado (401)
# Esperado: HTTP 401
POST {{AUTH_URL}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "invalid-non-existent-token-12345"
}

### 4.6 Registro con Password Débil sin Números (400)
# Esperado: HTTP 400
POST {{AUTH_URL}}/auth/register
Content-Type: application/json

{
  "name": "Password Debil",
  "email": "debil@sanpollo.com",
  "password": "sololetras",
  "role": "CLIENTE"
}
