# ==============================================================================
# SISTEMA POLLERÍA - PLANTILLA DE VARIABLES DE PRODUCCIÓN (GCP CLOUD RUN)
# ==============================================================================
# IMPORTANTE: Copia este archivo a .env.production y completa los valores reales.
# NUNCA comitees .env.production a git ni expongas contraseñas reales.
# ==============================================================================

# 1. Configuración de GCP Project y Región
GCP_PROJECT_ID=tu-proyecto-gcp-id
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=polleria-repo

# 2. Base de Datos (Cloud SQL PostgreSQL o AWS RDS)
# Para Cloud SQL usar el socket o IP pública/privada con SSL
DB_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require
DB_USERNAME=postgres_user
DB_PASSWORD=TU_PASSWORD_SEGURO_AQUI

# 3. Seguridad & JWT (Mínimo 256 bits criptográficos)
JWT_SECRET=GENERA_UNA_CLAVE_DE_ALTA_ENTROPIA_DE_MINIMO_32_CARACTERES
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# 4. Orígenes Permitidos (CORS - URL de tu Frontend en Vercel)
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,https://polleria.tu-dominio.com

# 5. Pasarela de Pagos (Mercado Pago Producción)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_PRODUCCION

# 6. Servicio de Correo (SMTP / 2FA)
MAIL_USERNAME=notificaciones@tu-dominio.com
MAIL_PASSWORD=TU_APP_PASSWORD_SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 7. URLs de Microservicios Inter-servicio en Cloud Run
AUTH_SERVICE_URL=https://auth-service-xxxx-uc.a.run.app
ORDERS_SERVICE_URL=https://orders-service-xxxx-uc.a.run.app
PAYMENTS_SERVICE_URL=https://payments-service-xxxx-uc.a.run.app
